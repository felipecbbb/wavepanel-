# Plantilla de variables de entorno por cliente.
# Copia a `.env` en el repo clonado y rellena con los valores reales del cliente.
# NUNCA commitees el .env (debe estar en .gitignore).

# ── Supabase (proyecto exclusivo del cliente) ──
VITE_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxx

# Service role solo para Edge Functions y scripts admin (NO frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe ──
VITE_STRIPE_PUBLIC_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ── Resend (emails transaccionales) ──
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=reservas@cliente.com
EMAIL_FROM_NAME="Nombre Cliente"
EMAIL_NOTIFY_ADMIN=admin@cliente.com

# ── Otros opcionales ──
# Si usan Plausible/GA en analytics
VITE_PLAUSIBLE_DOMAIN=cliente.com

# Sentry, etc — opcional
SENTRY_DSN=
